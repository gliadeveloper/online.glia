// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  COACH
  USER
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum LessonType {
  VIDEO
  TEXT
  QUIZ
  ASSIGNMENT
  LIVE
}

enum ContentType {
  VIDEO
  PDF
  HTML
  LINK
  FILE
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
  SUSPENDED
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  GRADED
  RETURNED
}

enum NotificationType {
  SYSTEM
  COURSE
  ASSIGNMENT
  QUIZ
  DISCUSSION
  CERTIFICATE
  COACHING
}

enum DiscussionType {
  QUESTION
  ANNOUNCEMENT
  GENERAL
}

enum ProductKind {
  COURSE_ONLY
  COACHING_ONLY
  BUNDLE
}

enum ProductItemKind {
  COURSE_ACCESS
  COACHING_ACCESS
}

enum CoachingDeliveryMode {
  LIVE
  ASYNC
  HYBRID
}

enum OrderStatus {
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum FulfillmentStatus {
  PENDING
  COMPLETED
  FAILED
  REVOKED
}

enum EntitlementGrantType {
  COURSE
  COACHING
}

enum CoachingEntitlementStatus {
  ACTIVE
  EXPIRED
  EXHAUSTED
  SUSPENDED
  REVOKED
}

enum CoachingSessionStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  NO_SHOW
  CANCELLED_BY_USER
  CANCELLED_BY_COACH
  RESCHEDULED
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

enum FormPurpose {
  DAILY_CHECKIN
  WEEKLY_CHECKIN
  SURVEY
  INTAKE
}

enum FormSchedule {
  ONCE
  DAILY
  WEEKLY
}

enum FormStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FormQuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  SHORT_TEXT
  LONG_TEXT
  YES_NO
  SCALE
}

// ─── User & Organization ─────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile              Profile?
  organizationMembers  OrganizationMember[]
  instructedCourses    Course[]             @relation("CourseInstructor")
  enrollments          Enrollment[]
  quizAttempts         QuizAttempt[]
  submissions          Submission[]
  gradedSubmissions    Submission[]         @relation("SubmissionGrader")
  reviews              Review[]
  certificates         Certificate[]
  notifications        Notification[]
  discussions          Discussion[]
  discussionReplies    DiscussionReply[]
  lessonBookmarks      LessonBookmark[]
  lessonNotes          LessonNote[]
  orders               Order[]
  coachedOfferings     CoachingOffering[]   @relation("CoachingOfferingCoach")
  coachingEntitlements CoachingEntitlement[]
  coachingSessionsAsCoach  CoachingSession[] @relation("CoachingSessionCoach")
  coachingSessionsAsStudent CoachingSession[] @relation("CoachingSessionStudent")
  coachingFeedbacks    CoachingFeedback[]
  coachingSessionEvents CoachingSessionEvent[]
  auditLogs            AuditLog[]
  createdForms         Form[]             @relation("FormCreator")
  formSubmissions      FormSubmission[]

  @@map("users")
}

model Profile {
  id        String  @id @default(cuid())
  userId    String  @unique
  avatarUrl String?
  bio       String?
  headline  String?
  website   String?
  timezone  String?
  locale    String  @default("ko")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members OrganizationMember[]
  courses Course[]
  products Product[]
  forms   Form[]

  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  joinedAt       DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

// ─── Taxonomy ──────────────────────────────────────────────────────────────────

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  parentId    String?
  order       Int     @default(0)

  parent   Category?        @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]       @relation("CategoryTree")
  courses  CourseCategory[]

  @@map("categories")
}

model Tag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  courses CourseTag[]

  @@map("tags")
}

// ─── Course Content ────────────────────────────────────────────────────────────

model Course {
  id           String       @id @default(cuid())
  title        String
  slug         String       @unique
  description  String?
  thumbnailUrl String?
  instructorId String
  organizationId String?
  status       CourseStatus @default(DRAFT)
  level        CourseLevel  @default(ALL_LEVELS)
  /// @deprecated Use Product.listPrice for sales. Kept for legacy display.
  price        Float        @default(0)
  currency     String       @default("KRW")
  isFeatured   Boolean      @default(false)
  publishedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  instructor   User               @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: Restrict)
  organization Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  modules      Module[]
  enrollments  Enrollment[]
  categories   CourseCategory[]
  tags         CourseTag[]
  prerequisites CoursePrerequisite[] @relation("CoursePrerequisites")
  requiredBy   CoursePrerequisite[] @relation("PrerequisiteCourses")
  reviews      Review[]
  certificates Certificate[]
  discussions  Discussion[]
  productItems ProductItem[]
  coachingOfferings CoachingOffering[]
  coachingEntitlements CoachingEntitlement[]
  forms            Form[]

  @@index([instructorId])
  @@index([status])
  @@map("courses")
}

model CoursePrerequisite {
  id             String @id @default(cuid())
  courseId       String
  prerequisiteId String

  course       Course @relation("CoursePrerequisites", fields: [courseId], references: [id], onDelete: Cascade)
  prerequisite Course @relation("PrerequisiteCourses", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([courseId, prerequisiteId])
  @@map("course_prerequisites")
}

model CourseCategory {
  courseId   String
  categoryId String

  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([courseId, categoryId])
  @@map("course_categories")
}

model CourseTag {
  courseId String
  tagId    String

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([courseId, tagId])
  @@map("course_tags")
}

model Module {
  id          String  @id @default(cuid())
  courseId    String
  title       String
  description String?
  order       Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, order])
  @@map("modules")
}

model Lesson {
  id          String     @id @default(cuid())
  moduleId    String
  title       String
  description String?
  type        LessonType @default(VIDEO)
  order       Int        @default(0)
  duration    Int?
  isFree      Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  module          Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  contents        Content[]
  progress        LessonProgress[]
  quiz            Quiz?
  assignment      Assignment?
  bookmarks       LessonBookmark[]
  notes           LessonNote[]
  discussions     Discussion[]

  @@index([moduleId, order])
  @@map("lessons")
}

model Content {
  id       String      @id @default(cuid())
  lessonId String
  type     ContentType
  title    String?
  url      String?
  body     String?
  metadata Json?
  order    Int         @default(0)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, order])
  @@map("contents")
}

// ─── Enrollment & Progress ─────────────────────────────────────────────────────

model Enrollment {
  id              String           @id @default(cuid())
  userId          String
  courseId        String
  status          EnrollmentStatus @default(ACTIVE)
  progressPercent Float            @default(0)
  enrolledAt      DateTime         @default(now())
  completedAt     DateTime?
  lastAccessedAt  DateTime?
  updatedAt       DateTime         @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course       Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress     LessonProgress[]
  certificate  Certificate?
  entitlementGrants EntitlementGrant[]
  coachingEntitlements CoachingEntitlement[]

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

model LessonProgress {
  id             String         @id @default(cuid())
  enrollmentId   String
  lessonId       String
  status         ProgressStatus @default(NOT_STARTED)
  watchedSeconds Int            @default(0)
  completedAt    DateTime?
  updatedAt      DateTime       @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@map("lesson_progress")
}

model LessonBookmark {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_bookmarks")
}

model LessonNote {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  body      String
  timestamp Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, lessonId])
  @@map("lesson_notes")
}

// ─── Assessment: Quiz ────────────────────────────────────────────────────────────

model Quiz {
  id               String  @id @default(cuid())
  lessonId         String  @unique
  title            String
  description      String?
  passingScore     Float   @default(70)
  timeLimitMinutes Int?
  maxAttempts      Int?
  shuffleQuestions Boolean @default(false)

  lesson    Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  QuizAttempt[]

  @@map("quizzes")
}

model Question {
  id           String       @id @default(cuid())
  quizId       String
  type         QuestionType @default(SINGLE_CHOICE)
  prompt       String
  explanation  String?
  points       Float        @default(1)
  order        Int          @default(0)

  quiz    Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options QuestionOption[]
  answers QuizAnswer[]

  @@index([quizId, order])
  @@map("questions")
}

model QuestionOption {
  id         String  @id @default(cuid())
  questionId String
  label      String
  isCorrect  Boolean @default(false)
  order      Int     @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, order])
  @@map("question_options")
}

model QuizAttempt {
  id          String    @id @default(cuid())
  quizId      String
  userId      String
  score       Float?
  isPassed    Boolean?
  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@index([quizId, userId])
  @@map("quiz_attempts")
}

model QuizAnswer {
  id         String @id @default(cuid())
  attemptId  String
  questionId String
  answerText String?
  optionIds  Json?

  attempt  QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@map("quiz_answers")
}

// ─── Assessment: Assignment ──────────────────────────────────────────────────────

model Assignment {
  id          String    @id @default(cuid())
  lessonId    String    @unique
  title       String
  description String?
  maxScore    Float     @default(100)
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@map("assignments")
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  userId       String
  content      String?
  fileUrl      String?
  status       SubmissionStatus @default(DRAFT)
  score        Float?
  feedback     String?
  gradedById   String?
  submittedAt  DateTime?
  gradedAt     DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  gradedBy   User?      @relation("SubmissionGrader", fields: [gradedById], references: [id], onDelete: SetNull)

  @@index([assignmentId, userId])
  @@map("submissions")
}

// ─── Social & Engagement ─────────────────────────────────────────────────────────

model Review {
  id        String   @id @default(cuid())
  courseId  String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@map("reviews")
}

model Discussion {
  id        String         @id @default(cuid())
  courseId  String
  lessonId  String?
  userId    String
  type      DiscussionType @default(GENERAL)
  title     String
  body      String
  isPinned  Boolean        @default(false)
  isClosed  Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  course  Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson  Lesson?           @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies DiscussionReply[]

  @@index([courseId])
  @@map("discussions")
}

model DiscussionReply {
  id           String   @id @default(cuid())
  discussionId String
  userId       String
  body         String
  isAccepted   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([discussionId])
  @@map("discussion_replies")
}

// ─── Certificate & Notification ────────────────────────────────────────────────

model Certificate {
  id             String   @id @default(cuid())
  enrollmentId   String   @unique
  userId         String
  courseId       String
  certificateNo  String   @unique
  issuedAt       DateTime @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("certificates")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  body      String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ─── Catalog: Coaching Offering & Product ──────────────────────────────────────

model CoachingOffering {
  id              String               @id @default(cuid())
  title           String
  slug            String               @unique
  description     String?
  deliveryMode    CoachingDeliveryMode @default(LIVE)
  totalSessions   Int
  validDays       Int
  sessionMinutes  Int                  @default(30)
  maxQuestions    Int?
  responseDays    Int?
  coachId         String?
  courseId        String?
  cancelPolicy    Json?
  refundPolicy    Json?
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  coach        User?                 @relation("CoachingOfferingCoach", fields: [coachId], references: [id], onDelete: SetNull)
  course       Course?               @relation(fields: [courseId], references: [id], onDelete: SetNull)
  productItems ProductItem[]
  entitlements CoachingEntitlement[]

  @@index([coachId])
  @@index([courseId])
  @@map("coaching_offerings")
}

model Product {
  id             String      @id @default(cuid())
  slug           String      @unique
  title          String
  description    String?
  kind           ProductKind
  listPrice      Int
  salePrice      Int?
  currency       String      @default("KRW")
  isActive       Boolean     @default(true)
  organizationId String?
  publishedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  items        ProductItem[]
  orderLines   OrderLine[]

  @@index([kind, isActive])
  @@map("products")
}

model ProductItem {
  id                 String          @id @default(cuid())
  productId          String
  kind               ProductItemKind
  courseId           String?
  coachingOfferingId String?
  quantity           Int             @default(1)
  sortOrder          Int             @default(0)

  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  course           Course?           @relation(fields: [courseId], references: [id], onDelete: SetNull)
  coachingOffering CoachingOffering? @relation(fields: [coachingOfferingId], references: [id], onDelete: SetNull)
  entitlementGrants EntitlementGrant[]

  @@index([productId, sortOrder])
  @@map("product_items")
}

// ─── Commerce: Order & Payment ─────────────────────────────────────────────────

model Order {
  id             String      @id @default(cuid())
  userId         String
  status         OrderStatus @default(PENDING)
  subtotal       Int
  discount       Int         @default(0)
  total          Int
  currency       String      @default("KRW")
  idempotencyKey String?     @unique
  paidAt         DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  lines        OrderLine[]
  payments     Payment[]
  fulfillments Fulfillment[]
  refunds      Refund[]

  @@index([userId, status])
  @@map("orders")
}

model OrderLine {
  id        String @id @default(cuid())
  orderId   String
  productId String
  quantity  Int    @default(1)
  unitPrice Int
  lineTotal Int

  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  entitlementGrants EntitlementGrant[]

  @@index([orderId])
  @@map("order_lines")
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  provider    String
  providerRef String        @unique
  amount      Int
  status      PaymentStatus @default(PENDING)
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments")
}

model Refund {
  id         String       @id @default(cuid())
  orderId    String
  amount     Int
  reason     String?
  status     RefundStatus @default(PENDING)
  refundedAt DateTime?
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("refunds")
}

// ─── Fulfillment: Entitlement Grant ────────────────────────────────────────────

model Fulfillment {
  id          String            @id @default(cuid())
  orderId     String
  status      FulfillmentStatus @default(PENDING)
  fulfilledAt DateTime?
  revokedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  order  Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  grants EntitlementGrant[]

  @@index([orderId])
  @@map("fulfillments")
}

model EntitlementGrant {
  id                    String               @id @default(cuid())
  fulfillmentId         String
  orderLineId           String
  productItemId         String
  grantType             EntitlementGrantType
  enrollmentId          String?
  coachingEntitlementId String?
  createdAt             DateTime             @default(now())

  fulfillment         Fulfillment          @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  orderLine           OrderLine            @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  productItem         ProductItem          @relation(fields: [productItemId], references: [id], onDelete: Restrict)
  enrollment          Enrollment?          @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  coachingEntitlement CoachingEntitlement? @relation(fields: [coachingEntitlementId], references: [id], onDelete: SetNull)

  @@index([fulfillmentId])
  @@index([orderLineId])
  @@map("entitlement_grants")
}

// ─── Coaching: Entitlement, Session & Feedback ─────────────────────────────────

model CoachingEntitlement {
  id                 String                    @id @default(cuid())
  userId             String
  coachingOfferingId String
  coachId            String?
  courseId           String?
  enrollmentId       String?
  totalSessions      Int
  usedSessions       Int                       @default(0)
  reservedSessions   Int                       @default(0)
  validFrom          DateTime                  @default(now())
  validUntil         DateTime
  status             CoachingEntitlementStatus @default(ACTIVE)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  coachingOffering CoachingOffering   @relation(fields: [coachingOfferingId], references: [id], onDelete: Restrict)
  course           Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  enrollment       Enrollment?        @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  grants           EntitlementGrant[]
  sessions         CoachingSession[]
  intakes          CoachingIntake[]
  feedbacks        CoachingFeedback[]

  @@index([userId, status])
  @@index([coachingOfferingId])
  @@map("coaching_entitlements")
}

model CoachingSession {
  id              String                @id @default(cuid())
  entitlementId   String
  coachId         String
  userId          String
  sessionNo       Int
  status          CoachingSessionStatus @default(SCHEDULED)
  scheduledAt     DateTime
  durationMinutes Int                   @default(30)
  meetingUrl      String?
  meetingProvider String?
  cancelledAt     DateTime?
  cancelReason    String?
  completedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  entitlement CoachingEntitlement    @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  coach       User                   @relation("CoachingSessionCoach", fields: [coachId], references: [id], onDelete: Restrict)
  user        User                   @relation("CoachingSessionStudent", fields: [userId], references: [id], onDelete: Cascade)
  intake      CoachingIntake?
  feedback    CoachingFeedback?
  events      CoachingSessionEvent[]

  @@index([entitlementId, sessionNo])
  @@index([coachId, scheduledAt])
  @@index([userId, scheduledAt])
  @@map("coaching_sessions")
}

model CoachingSessionEvent {
  id         String                 @id @default(cuid())
  sessionId  String
  actorId    String?
  fromStatus CoachingSessionStatus?
  toStatus   CoachingSessionStatus
  note       String?
  createdAt  DateTime               @default(now())

  session CoachingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  actor   User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([sessionId, createdAt])
  @@map("coaching_session_events")
}

model CoachingIntake {
  id            String   @id @default(cuid())
  entitlementId String
  sessionId     String?  @unique
  answers       Json
  attachments   Json?
  submittedAt   DateTime @default(now())

  entitlement CoachingEntitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  session     CoachingSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([entitlementId])
  @@map("coaching_intakes")
}

model CoachingFeedback {
  id            String   @id @default(cuid())
  entitlementId String?
  sessionId     String?  @unique
  coachId       String
  body          String
  attachments   Json?
  deliveredAt   DateTime @default(now())

  entitlement CoachingEntitlement? @relation(fields: [entitlementId], references: [id], onDelete: SetNull)
  session     CoachingSession?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  coach       User                 @relation(fields: [coachId], references: [id], onDelete: Restrict)

  @@index([entitlementId])
  @@map("coaching_feedbacks")
}

// ─── Ops: Audit & Idempotency ──────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  entityType String
  entityId   String
  action     String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model IdempotencyKey {
  id        String   @id @default(cuid())
  key       String   @unique
  scope     String
  response  Json?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([scope, expiresAt])
  @@map("idempotency_keys")
}

// ─── Forms: Daily Check-in & Surveys ───────────────────────────────────────────

model Form {
  id             String       @id @default(cuid())
  slug           String       @unique
  title          String
  description    String?
  purpose        FormPurpose  @default(SURVEY)
  schedule       FormSchedule @default(ONCE)
  status         FormStatus   @default(DRAFT)
  timezone       String       @default("Asia/Seoul")
  openTime       String?
  closeTime      String?
  createdById    String
  organizationId String?
  courseId       String?
  publishedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  createdBy    User             @relation("FormCreator", fields: [createdById], references: [id], onDelete: Restrict)
  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  course       Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  questions    FormQuestion[]
  submissions  FormSubmission[]

  @@index([purpose, status])
  @@map("forms")
}

model FormQuestion {
  id          String           @id @default(cuid())
  formId      String
  prompt      String
  description String?
  type        FormQuestionType
  order       Int              @default(0)
  isRequired  Boolean          @default(true)
  metadata    Json?

  form    Form         @relation(fields: [formId], references: [id], onDelete: Cascade)
  options FormOption[]
  answers FormAnswer[]

  @@index([formId, order])
  @@map("form_questions")
}

model FormOption {
  id         String  @id @default(cuid())
  questionId String
  label      String
  value      String?
  emoji      String?
  order      Int     @default(0)

  question FormQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  FormAnswer[]

  @@index([questionId, order])
  @@map("form_options")
}

model FormSubmission {
  id          String   @id @default(cuid())
  formId      String
  userId      String
  checkInDate String
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  form    Form         @relation(fields: [formId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers FormAnswer[]

  @@unique([formId, userId, checkInDate])
  @@index([userId, checkInDate])
  @@map("form_submissions")
}

model FormAnswer {
  id           String  @id @default(cuid())
  submissionId String
  questionId   String
  optionId     String?
  optionIds    Json?
  textValue    String?
  numberValue  Float?

  submission FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   FormQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option     FormOption?    @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@unique([submissionId, questionId])
  @@map("form_answers")
}
