# 서버용 빈 목록. 복사: cp deploy/env.production.example .env
# 로컬 next/prisma 는 .env.local 이 같은 키를 덮어쓴다. 서버에는 .env.local 을 넣지 않는다.

# ── PostgreSQL (docker-compose db service) ──
POSTGRES_USER=glia
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=online_glia

# App → DB (same host as compose service name "db")
DATABASE_URL=postgresql://glia:CHANGE_ME_strong_password@db:5432/online_glia?schema=public

# ── Session (required) ──
# openssl rand -base64 32
SESSION_SECRET=CHANGE_ME_use_openssl_rand_base64_32

# Public URL (redirects behind Caddy/nginx — optional if KAKAO_REDIRECT_URI is set)
APP_URL=https://online.glia.kr

# ── Kakao OAuth (optional) ──
# Redirect URI must match Kakao Developers console exactly
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=https://online.glia.kr/api/auth/kakao/callback
KAKAO_CLIENT_SECRET=

# ── Cloudflare R2 (optional — lesson/coaching images) ──
R2_BUCKET=
R2_ENDPOINT=
# Account endpoint only (no bucket path). Set together with the new app:
# R2_LEGACY_KEY_PREFIX=online-glia/ for the verified existing production bucket.
# New/isolated buckets use an empty prefix unless their inventory proves otherwise.
R2_LEGACY_KEY_PREFIX=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
R2_REGION=auto

# Runtime rollout: off (default), admin, all. No NEXT_PUBLIC build-time flags.
# off keeps the existing contextual course/coaching uploader.
MEDIA_LIBRARY_ROLLOUT=off
# Only enables NEW library uploads; disabled also pauses completion requests.
MEDIA_LIBRARY_UPLOADS=disabled
# Set only after production privacy/CORS, capacity and rollout checks pass.
# Exact account origin + bucket, e.g. https://ACCOUNT.r2.cloudflarestorage.com/online-glia
# Also requires NODE_ENV=production, empty R2_PUBLIC_BASE_URL and the legacy prefix above.
MEDIA_R2_PRODUCTION_TARGET=

# ── Toss Payments (optional — product checkout) ──
# Live keys charge real payment methods. Leave empty until the live keys are issued.
# Checkout uses the payment widget. Client and secret must both be live widget keys (live_gck_/live_gsk_).
# The secret key is server-only. Do not set NEXT_PUBLIC_ copies.
# Webhook, per MID: {APP_URL}/api/payments/toss/webhook
# Public HTTPS POST on port 443. Return 200 within 10 seconds. Does not change orders.
TOSS_PAYMENTS_ENV=live
TOSS_PAYMENTS_CLIENT_KEY=
TOSS_PAYMENTS_SECRET_KEY=
